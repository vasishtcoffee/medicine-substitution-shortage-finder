# Copy to .env and edit. .env is git-ignored. LOCAL DEMO VALUES ONLY.
# ---- MySQL server ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=medsub
# Used ONLY by scripts/bootstrap_db.py to create the database and accounts. The app never uses it.
MYSQL_ROOT_USER=root
MYSQL_ROOT_PASSWORD=change-me-root
# Host part of the app accounts ('%' works for local and Docker)
APP_ACCOUNT_HOST=%
# Schema-administration account (migrations, seed)
MIGRATOR_USER=medsub_migrator
MIGRATOR_PASSWORD=change-me-migrator
# Locked account that owns SECURITY DEFINER routines (cannot log in)
DEFINER_USER=medsub_definer
# Runtime accounts, one per role (each has a default MySQL role)
PATIENT_SVC_USER=app_patient_svc
PATIENT_SVC_PASSWORD=change-me-patient-svc
PHARMACIST_SVC_USER=app_pharmacist_svc
PHARMACIST_SVC_PASSWORD=change-me-pharmacist-svc
ADMIN_SVC_USER=app_admin_svc
ADMIN_SVC_PASSWORD=change-me-admin-svc
AUTH_SVC_USER=app_auth_svc
AUTH_SVC_PASSWORD=change-me-auth-svc
# ---- MongoDB ----
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DATABASE=medsub_feed
# ---- Backend ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=60
COOKIE_SECURE=false
SYNC_INTERVAL_SECONDS=15
SYNC_MAX_ATTEMPTS=5
# ---- Local demo logins (seeded by scripts/seed.py) ----
DEMO_ADMIN_PASSWORD=change-me-demo-admin
DEMO_PHARMACIST_PASSWORD=change-me-demo-pharmacist
DEMO_PATIENT_PASSWORD=change-me-demo-patient
